     "\ud53c\ubd80 \uc790\uadf9, \ud1b5\uc99d\uc5c6\ub294 \ubb34\ud1b5 \uc81c\ubaa8",
     "\ud0c8\ubaa8 \uc608\ubc29\uacfc \uce58\ub8cc, \uc904\uae30\uc138\ud3ec \ud0c8\ubaa8 \uc8fc\uc0ac\ub3c4 \uc5d0\uc2a4\ub4c8",
     "\uadfc\ubcf8\uc774 \ub2e4\ub978 \ub9ac\ud504\ud305",
     "\ub9d1\uc740 \ud53c\ubd80\ub97c \uc704\ud55c \uc644\ubcbd\ud55c \uc0c9\uc18c \uc81c\uac70 \uc194\ub8e8\uc158",
     "\ud53c\ubd80 \uc790\uadf9, \ud1b5\uc99d\uc5c6\ub294 \ubb34\ud1b5 \uc81c\ubaa8"
    ],
    "keyText": "\ud53c\ubd80 \uc790\uadf9, \ud1b5\uc99d\uc5c6\ub294 \ubb34\ud1b5 \uc81c\ubaa8 \uc774\uc81c \uc81c\ubaa8\uc5d0 \ub300\ud55c \uc2a4\ud2b8\ub808\uc2a4\ub294 STOP! \uc790\uadf9\uc73c\ub85c \uc2dc\ub2ec\ub9ac\ub294 \uc2dc\uc220\uc740 \uba48\ucd94\uace0 \ubc18\uc601\uad6c\uc801\uc774\uace0 \uc548\uc804\ud55c \ucfe8\ub9c1\uc2dc\uc2a4\ud15c \uc801\uc6a9 \ubb34\ud1b5 \uc81c\ubaa8\ub97c \ub9cc\ub098\ubcf4\uc138\uc694. \ud0c8\ubaa8 \uc608\ubc29\uacfc \uce58\ub8cc, \uc904\uae30\uc138\ud3ec \ud0c8\ubaa8 \uc8fc\uc0ac\ub3c4 \uc5d0\uc2a4\ub4c8 \uc2dc\uac04\uacfc \uacbd\ud5d8\uc774 \uc911\uc694\ud55c \ud0c8\ubaa8 \uce58\ub8cc. \ud569\ub9ac\uc801\uc778 \ube44\uc6a9\uacfc \ud568\uaed8\ud558\ub294 \uccad\uc8fc \ud0c8\ubaa8\uc131\uc9c0\ub85c\uc368 \uac80\uc99d\ub41c \uce58\ub8cc\ubc95\uacfc \ub9de\ucda4\ucc98\ubc29\uc73c\ub85c \uc790\uc2e0\uac10 \ucc3e\uae30\ub97c \ud568\uaed8 \ud569\ub2c8\ub2e4. \uadfc\ubcf8\uc774 \ub2e4\ub978 \ub9ac\ud504\ud305 \ub178\ud6c4\ub41c \uadfc\uc721\uc744 \uc80a\uc5c8\uc744 \ub54c\ub85c \ub418\ub3cc\ub9ac\ub294 \ubc14\ud0d5\uc791\uc5c5\ubd80\ud130, \ud53c\ubd80\uc0c1\ud0dc\uc5d0 \ub530\ub77c \ucef4\ube44\ub124\uc774\uc158 \uc2dc\uc220\uae4c\uc9c0! \ub9d1\uc740 \ud53c\ubd80\ub97c \uc704\ud55c \uc644\ubcbd\ud55c \uc0c9\uc18c \uc81c\uac70 \uc194\ub8e8\uc158 \uc0c9\uc18c\uc758 \uc885\ub958, \ud53c\ubd80\uc758 \ud0c0\uc785\uc5d0 \ub530\ub77c \uc815\ud655\ud55c \ud0c0\ucf13 \uc124\uc815, \ucd5c\uc801\uc758 \ub808\uc774\uc800 \ubcf5\ud569 \uc194\ub8e8\uc158\uc73c\ub85c \ub9de\ucda4\uce58\ub8cc. \uc5d0\uc2a4\ub4c8\ub9cc\uc758 \uc815\uad50\ud55c \ub808\uc774\uc800 \uc870\ud569 \uce58\ub8cc\ub97c \ud1b5\ud574 \ub9d1\uc740 \ud53c\ubd80\ub97c \ub418\ucc3e\uc73c\uc138\uc694! \ud53c\ubd80 \uc790\uadf9, \ud1b5\uc99d\uc5c6\ub294 \ubb34\ud1b5 \uc81c\ubaa8 \uc774\uc81c \uc81c\ubaa8\uc5d0 \ub300\ud55c \uc2a4\ud2b8\ub808\uc2a4\ub294 STOP! \uc790\uadf9\uc73c\ub85c \uc2dc\ub2ec\ub9ac\ub294 \uc2dc\uc220\uc740 \uba48\ucd94\uace0 \ubc18\uc601\uad6c\uc801\uc774\uace0 \uc548\uc804\ud55c \ucfe8\ub9c1\uc2dc\uc2a4\ud15c \uc801\uc6a9 \ubb34\ud1b5 \uc81c\ubaa8\ub97c \ub9cc\ub098\ubcf4\uc138\uc694. \ud0c8\ubaa8 \uc608\ubc29\uacfc \uce58\ub8cc, \uc904\uae30\uc138\ud3ec \ud0c8\ubaa8 \uc8fc\uc0ac\ub3c4 \uc5d0\uc2a4\ub4c8 \uc2dc\uac04\uacfc \uacbd\ud5d8\uc774 \uc911\uc694\ud55c \ud0c8\ubaa8 \uce58\ub8cc. \ud569\ub9ac\uc801\uc778 \ube44\uc6a9\uacfc \ud568\uaed8\ud558\ub294 \uccad\uc8fc \ud0c8\ubaa8\uc131\uc9c0\ub85c\uc368 \uac80\uc99d\ub41c \uce58\ub8cc\ubc95\uacfc \ub9de\ucda4\ucc98\ubc29\uc73c\ub85c \uc790\uc2e0\uac10 \ucc3e\uae30\ub97c \ud568\uaed8 \ud569\ub2c8\ub2e4. \uadfc\ubcf8\uc774 \ub2e4\ub978 \ub9ac\ud504\ud305 \ub178\ud6c4\ub41c \uadfc\uc721\uc744 \uc80a\uc5c8\uc744 \ub54c\ub85c \ub418\ub3cc\ub9ac\ub294 \ubc14\ud0d5\uc791\uc5c5\ubd80\ud130, \ud53c\ubd80\uc0c1\ud0dc\uc5d0 \ub530\ub77c \ucef4\ube44\ub124\uc774\uc158 \uc2dc\uc220\uae4c\uc9c0! \ub9d1\uc740 \ud53c\ubd80\ub97c \uc704\ud55c \uc644\ubcbd\ud55c \uc0c9\uc18c \uc81c\uac70 \uc194\ub8e8\uc158 \uc0c9\uc18c\uc758 \uc885\ub958, \ud53c\ubd80\uc758 \ud0c0\uc785\uc5d0 \ub530\ub77c \uc815\ud655\ud55c \ud0c0\ucf13 \uc124\uc815, \ucd5c\uc801\uc758 \ub808\uc774\uc800 \ubcf5\ud569 \uc194\ub8e8\uc158\uc73c\ub85c \ub9de\ucda4\uce58\ub8cc. ",
