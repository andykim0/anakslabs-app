   {
    "i": 18,
    "tag": "section",
    "absTop": 15344,
    "h": 1078,
    "chars": 181,
    "headings": [
     "\uace0\uac1d\uc758 \ud3b8\uc548\ud568\uc744 \uace0\ub824\ud55c \uc9c4\ub8cc \uacf5\uac04."
    ],
    "keyText": "\uace0\uac1d\uc758 \ud3b8\uc548\ud568\uc744 \uace0\ub824\ud55c \uc9c4\ub8cc \uacf5\uac04. \uc6c3\ub294\uc5bc\uad74\uce58\uacfc\ub294 \ud658\uc790\ubd84\uc758 \ub3d9\uc120\uc744 \uba3c\uc800 \uace0\ubbfc\ud569\ub2c8\ub2e4. \uc9c4\ub8cc \uc804 \ub300\uae30\ubd80\ud130 \uce58\ub8cc \ud6c4 \ud68c\ubcf5\uae4c\uc9c0, \uc774\ub3d9\uc774 \ubc88\uac70\ub86d\uc9c0 \uc54a\ub3c4\ub85d \uacf5\uac04\uc744 \uc720\uae30\uc801\uc73c\ub85c \uc124\uacc4\ud588\uc2b5\ub2c8\ub2e4. \uc804\uc6a9 \ud68c\ubcf5\uc2e4\uacfc \uc218\uc561\uc2e4\ub3c4 \ub9c8\ub828\ub418\uc5b4 \uc788\uc5b4 \uc870\uc6a9\ud558\uace0 \uc544\ub291\ud55c \uacf5\uac04\uc5d0\uc11c \ucda9\ubd84\ud55c \ud68c\ubcf5\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ubcf4\uc774\uc9c0 \uc54a\ub294 \uc138\uc2ec\ud568\uc774 \uc6c3\ub294\uc5bc\uad74\uce58\uacfc\ub97c \ub354 \ud3b8\uc548\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.",
    "media": 44,
