   {
    "i": 10,
    "tag": "section",
    "absTop": 4096,
    "h": 1012,
    "chars": 186,
    "headings": [],
    "keyText": "\uc544\ubb34 \ub370\ub098 \uac00\uae34 \uc2eb\uace0, \uc5b4\ub514\uac00 \uc88b\uc740\uc9c0\ub3c4 \ubaa8\ub974\uaca0\uace0\u2026 \uadf8\ub0e5, \ub531 \ubbff\uc744 \uc218 \uc788\ub294 \uce58\uacfc \ud558\ub098 \uc788\uc5c8\uc73c\uba74 \uc88b\uaca0\uc5b4\uc694. 01 \uc6d0\uc7a5\ub4e4\uc758 \uc2e4\ub825\uc774 \uc788\ub294\uc9c0 02 \uc544\ud504\uac8c \ud558\uc9c4 \uc54a\uc744\uc9c0 03 \uacfc\uc789\uc9c4\ub8cc\ub97c \ud558\uc9c0 \uc54a\ub294\uc9c0 04 \uba39\ud280 \uce58\uacfc\uba74 \uc5b4\uca4c\uc9c0? 05 \ub2e4\ub978 \ud658\uc790\ub4e4\uc740 \ub9cc\uc871 \ud558\ub294\uc9c0 \uac80\uc0c9\ud574 \ubcf4\uba74 \ub2e4 \uc798\ud55c\ub2e4\uace0 \ud558\ub2c8\uae4c \uacb0\uad6d \ub2e4\uc2dc, \u2018\uc5b4\ub514\ub97c \uac00\uc57c \ud558\uc9c0?\u2019\ub85c \ub3cc\uc544\uc624\uac8c \ub429\ub2c8\ub2e4.",
    "media": 1,
    "bgKey": "0,0,0",
    "bgLum": 0,
