    "headings": [
     "\uace0\ub09c\ub3c4 \uc218\uc220\ubd80\ud130 \ucd5c\uc2e0 \ube44\uc218\uc220\uae4c\uc9c0",
     "\uace0\ub09c\ub3c4 \uc218\uc220\ubd80\ud130 \ucd5c\uc2e0 \ube44\uc218\uc220\uae4c\uc9c0",
     "\ud611\uc9c4\uc2dc\uc2a4\ud15c - \uc131\ud615\uc678\uacfc",
     "\ud611\uc9c4\uc2dc\uc2a4\ud15c - \uc815\ud615\uc678\uacfc"
    ],
    "keyText": "\uace0\ub09c\ub3c4 \uc218\uc220\ubd80\ud130 \ucd5c\uc2e0 \ube44\uc218\uc220\uae4c\uc9c0 \uace0\ub09c\ub3c4 \uc218\uc220\ubd80\ud130 \ucd5c\uc2e0 \ube44\uc218\uc220\uae4c\uc9c0 01 \ubaa8\ub4e0 \uc815\ub9e5\ub958\uc758 \uce58\ub8cc\uc5d0 \ubd80\ud569\ud558\ub294 \ub2e8 \ud55c\uac00\uc9c0 \ubc29\ubc95\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \ud608\uad00\uc9c8\ud658 \uce58\ub8cc\uc5d0 \uc790\uc2e0\uc774 \uc788\ub2e4\uba74, \uac00\ubcbc\uc6b4 \uacbd\uc99d\ubd80\ud130 \uc911\uc99d \uc815\ub9e5\ub958\uae4c\uc9c0 \uc9c8\ud658\uc758 \uc0c1\ud0dc\uc640 \ud658\uc790\uc758 \uc694\uad6c\uc5d0 \ubd80\ud569\ud558\ub294 1\ub3001 \ub9de\ucda4 \uce58\ub8cc\ub97c \uc2dc\ud589\ud560 \uc218 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc774\ub2f4\uc678\uacfc\uc5d0\uc11c\ub294 \ud608\uad00\uc758 \ubc16\uc5d0\uc11c \uc811\uadfc\ud558\ub294 \uc678\uacfc\uc218\uc220\uacfc \ud608\uad00 \uc548\uc73c\ub85c \uc9c4\uc785\ud558\ub294 \uc778\ud130\ubca4\uc158(\uc911\uc7ac\uc801) \ube44\uc218\uc220\uc774 \ubaa8\ub450 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ud611\uc9c4\uc2dc\uc2a4\ud15c - \uc131\ud615\uc678\uacfc 02 \uc131\ud615\uc678\uacfc \uc804\ubb38\uc758\uc758 \uc9c4\ub8cc\ub97c \ud1b5\ud574, \uc911\uc99d \uc774\uc0c1\uc758 \ud558\uc9c0\uc815\ub9e5\ub958\uc5d0 \ub3d9\ubc18\ub418\ub294 \ud53c\ubd80\uc5fc\uc99d\u00b7\ud558\uc9c0\uada4\uc591\u00b7\ud53c\ubd80\uad34\uc0ac \ub4f1\uc758 \ud569\ubcd1\uc99d\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uce58\ub8cc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4 \ud611\uc9c4\uc2dc\uc2a4\ud15c - \uc815\ud615\uc678\uacfc 03 \ucc99\ucd94 \ubc0f \uad00\uc808 \uc9c8\ud658\uacfc \ud558\uc9c0\uc815\ub9e5\ub958\uc758 \uac10\ubcc4\uc744 \uc704\ud574 \ud608\uad00\uc678\uacfc \uc804\ubb38\uc758\uc640 \uc815\ud615\uc678\uacfc \uc804\ubb38\uc758\uac00 \ud611\ub825 \uc9c4\ub8cc\ud569\ub2c8\ub2e4. \uc5ec\ub7ec \ubcd1\uc6d0\uc744 \uac70\uce58\uc9c0 \uc54a\uace0 \ud55c \uacf3\uc5d0\uc11c \ud1b5\uc99d\uc758 \ub2e4\uc591\ud55c \uc6d0\uc778\uc744 \ud30c\uc545\ud558\uace0 \uce58\ub8cc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
