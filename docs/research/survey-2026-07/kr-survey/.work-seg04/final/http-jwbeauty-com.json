   "headings": [
    "\ud83d\udc68\u200d\u2695\ufe0f\ub208\ubc11\uc131\ud615\uc758 \ub300\uac00 Dr.\ucd5c\ud64d\ub9bc\uc774 \uc54c\ub824\uc8fc\ub294 \u2757\uc911\ub144 \ub208\ubc11 \uc218\uc220 \uc804 \uaf2d! \uc54c\uc544\uc57c \ud560 \uac83\ub4e4",
    "\u2728JW\uc815\uc6d0\uc131\ud615\uc678\uacfc\uc758 \uc790\ub791\u2728 \ub208\ubc11 \uc131\ud615\uc758 \ub300\uac00 \ucd5c\ud64d\ub9bc \uc6d0\uc7a5\ub2d8 \ud83d\udd8b",
    "JW\uc815\uc6d0\uc131\ud615\uc678\uacfc \ucd5c\ud64d\ub9bc \ub300\ud45c\uc6d0\uc7a5\uc758 \ucd5c\uc560\uc218\uc220 \ud558\uc548\uac80 \uc911\uc548\uba74\uac70\uc0c1\uc73c\ub85c \uc80a\uc74c\uc744 \ub418\ucc3e\uc544\ub4dc\ub9bd\ub2c8\ub2e4\ud83d\udc4f\ud83d\udc4f",
    "\ud558\uc548\uac80\uc218\uc220 1\uc778\uc790 \ucd5c\ud64d\ub9bc\uc6d0\uc7a5\uc774 \uc54c\ub824\uc8fc\ub294 #\ub208\ubc11\uc9c0 #\ud558\uc548\uac80 #\ud558\uc548\uac80\uc911\uc548\uba74\uac70\uc0c1 \ubb34\uc5c7\uc774\ub4e0 \ubb3c\uc5b4\ubcf4\uc138\uc694~!!!",
    "23\ub144\ub3d9\uc548 \ub208\ubc11\uc218\uc220\uc5d0 \uc9d1\uc911\ud574\uc628 \ub208\ube5b\ud64d\ub9bc\uc758 \ud558\uc548\uac80 \uc911\uc548\uba74\uac70\uc0c1 \ucf00\uc774\uc2a4\ub9ac\ubdf0\ud83d\ude4f\ud83d\udc99",
    "\ub208\ubc11\uc9c0\ubc29\uc7ac\ubc30\uce58, \uc65c \uc7ac\ubc1c\ud560\uae4c?"
   ],
   "keyText": "\ub208\uc131\ud615 \ucf54\uc131\ud615 \uac00\uc2b4\uc131\ud615 \uc548\ud2f0\uc5d0\uc774\uc9d5 \uae30\ud0c0 \uc1fc\uce20 \ud558\uc548\uac80\uc218\uc220 \ud6c4 \uc65c \uc80a\uc5b4 \ubcf4\uc774\uc9c0 \uc54a\uc744\uae4c?\ud83e\udd14\u2502\u2728\uc911\ub144\ub208\uc131\ud615\uc758 \uad8c\uc704\uc790\u2728 \ucd5c\ud64d\ub9bc \uc6d0\uc7a5\uc774 \uc54c\ub824\uc8fc\ub294 \ud558\uc548\uac80\uc218\uc220 \uc2dc \uc911\uc548\uba74\uae4c\uc9c0 \uc2e0\uacbd \uc368\uc57c \ud558\ub294 \uc774\uc720! \ud558\uc548\uac80\uc218\uc220 \uc2dc \uc911\uc548\uba74 \ud130\uce58\uac00 \ud544\uc694\ud55c \uc774\uc720\uc5d0 \ub300\ud574 \uc624\ub298 \uc790\uc138\ud558\uac8c \uc54c\ub824\ub4dc\ub9ac\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4\ud83d\udc4d\ud83d\udc4d \ucc98\uc9c4 \ub208\uaebc\ud480\ud83d\ude22 \ub098\ub294 \uc5b4\ub5a4 \uc218\uc220\uc744 \ubc1b\uc744 \uc218 \uc788\uc744\uae4c?\u2502\u2728\uc911\ub144\ub208\uc131\ud615\uc758 \uad8c\uc704\uc790\u2728 \ucd5c\ud64d\ub9bc \uc6d0\uc7a5\uc774 \uc54c\ub824\uc8fc\ub294 \ub208\uaebc\ud480\uc774 \ucc98\uc9c4 \uacbd\uc6b0 \ud560 \uc218 \uc788\ub294 4\uac00\uc9c0 \uc218\uc220\ubc95\u203c\ufe0f \uc911\ub144 \uc774\ud6c4 \ub208\uaebc\ud480\uc774 \ub9ce\uc774 \ucc98\uc838\uc11c \uace0\ubbfc\uc774\uc2e0 \ubd84\ub4e4\u2049 \uadf8\ub7f0 \ubd84\ub4e4\uc744 \uc704\ud574 \ub208\uaebc\ud480 \ucc98\uc9d0 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \ud574\uacb0\ud560 \uc218 \uc788\ub294 \uc218\uc220 \ubc29\ubc95\uc5d0 \ub300\ud574 \uc790\uc138\ud558\uac8c \uc54c\ub824\ub4dc\ub9ac\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4\ud83d\ude04 \ub208\ub9e4\uad50\uc815, \uc30d\uc218\ud558\ub7ec \uac14\ub2e4\uac00 \ucd94\ucc9c \ubc1b\ub294 \uc774\uc720\ub294?\ud83e\udd14\u2502JW\uc815\uc6d0\uc131\ud615\uc678\uacfc \ub208\uc131\ud615 \uc804\ubb38 \uae40\uc5f0\uc900 \uc6d0\uc7a5\uc774 \uc54c",
