    "headings": [
     "\uc218\uc900\ub192\uc740 \uc758\ub8cc\uc9c4\uc774 \ud3bc\uce58\ub294 \ud611\uc9c4\uc2dc\uc2a4\ud15c\uc73c\ub85c \ucc28\uc6d0\uc774 \ub2e4\ub978 \uc694\uc591\uc758\ub8cc\uae30\uad00",
     "CRE\u00b7VRE \uac10\uc5fc \uac71\uc815 \uc5c6\ub294 \ucca0\uc800\ud55c \ub3c5\ub9bd \uaca9\ub9ac\ubcd1\uc2e4 \uc6b4\uc601",
     "\ucca8\ub2e8\ub85c\ubd07\uacfc 50\uba85\uc758 \uc7ac\ud65c\uc804\ubb38\uac00",
     "\uc704\ub4dc\ubbf8\ub294 \uce58\ub8cc\ud558\ub294 \ubcd1\uc6d0\uc785\ub2c8\ub2e4. \uc911\uc99d\uc9c8\ud658, \ub05d\uae4c\uc9c0 \uce58\ub8cc\ud569\ub2c8\ub2e4.",
     "\ubbff\uc74c\uc774 \uac00\ub294 \ubcd1\uc6d0 \uc704\ub4dc\ubbf8\uc694\uc591\ubcd1\uc6d0"
    ],
    "keyText": "\uc218\uc900\ub192\uc740 \uc758\ub8cc\uc9c4\uc774 \ud3bc\uce58\ub294 \ud611\uc9c4\uc2dc\uc2a4\ud15c\uc73c\ub85c \ucc28\uc6d0\uc774 \ub2e4\ub978 \uc694\uc591\uc758\ub8cc\uae30\uad00 \ub0b4\uacfc, \uc7ac\ud65c\uc758\ud559\uacfc, \uc2e0\uacbd\uacfc, \uac00\uc815\uc758\ud559\uacfc, \ud55c\uc758\ud559\uacfc \uc804\ubb38\uc758\uac00 \ub0b4 \uac00\uc871\uac19\uc774 \uc9c4\ub8cc\ud569\ub2c8\ub2e4. CRE\u00b7VRE \uac10\uc5fc \uac71\uc815 \uc5c6\ub294 \ucca0\uc800\ud55c \ub3c5\ub9bd \uaca9\ub9ac\ubcd1\uc2e4 \uc6b4\uc601 \uc5c4\uaca9\ud55c \uac10\uc5fc \uad00\ub9ac \uc6d0\uce59 \uc900\uc218\uc640 \ucf8c\uc801\ud55c \uaca9\ub9ac \ud658\uacbd\uc73c\ub85c \uba74\uc5ed\ub825\uc774 \uc57d\ud55c \ud658\uc790\ubd84\ub4e4\ub3c4 \uc548\uc2ec\ud558\uace0 \ud68c\ubcf5\uc5d0\ub9cc \uc804\ub150\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucca8\ub2e8\ub85c\ubd07\uacfc 50\uba85\uc758 \uc7ac\ud65c\uc804\ubb38\uac00 \ucd5c\uc2e0 \ub85c\ubd07 \uc7ac\ud65c \uc2dc\uc2a4\ud15c\uacfc \uc219\ub828\ub41c \uce58\ub8cc\uc0ac\uc758 1:1 \uc9d1\uc911\ucf00\uc5b4\ub85c \uac00\uc7a5 \uacfc\ud559\uc801\uc778 \ud68c\ubcf5\uc744 \uc57d\uc18d\ud569\ub2c8\ub2e4. \uc704\ub4dc\ubbf8\ub294 \uce58\ub8cc\ud558\ub294 \ubcd1\uc6d0\uc785\ub2c8\ub2e4. \uc911\uc99d\uc9c8\ud658, \ub05d\uae4c\uc9c0 \uce58\ub8cc\ud569\ub2c8\ub2e4. \uc804\ubb38 \uc7ac\ud65c\ud504\ub85c\uadf8\ub7a8, \ucca0\uc800\ud55c \ud22c\uc57d\uad00\ub9ac, \uc704\ub4dc\ubbf8\uc758 \ubaa9\uc801\uc9c0\ub294 \uc548\uc815\uc774 \uc544\ub2c8\ub77c, '\uc77c\uc0c1\uc73c\ub85c\uc758 \ubcf5\uadc0'\uc785\ub2c8\ub2e4. \ubcf4\uac74\ubcf5\uc9c0\ubd80, \uac74\uac15\ubcf4\ud5d8\uc2ec\uc0ac\ud3c9\uac00\uc6d0 \uc778\uc815\ubc1b\uc740 \ubbff\uc74c\uc774 \uac00\ub294 \ubcd1\uc6d0 \uc704\ub4dc\ubbf8\uc694\uc591\ubcd1\uc6d0 \uc778\ucc9c\uc720\uc77c 5\ud68c\uc5f0\uc18d 1\ub4f1\uae09 \ud68d\ub4dd! \uae09\uc131\uae30\ud658\uc790 \ud1f4\uc6d0\uc9c0\uc6d0 \uc2dc\ubc94\uc0ac\uc5c5 \uc120\uc815! \uc218\uc900\ub192\uc740 \uc758\ub8cc\uc9c4\uc774 \ud3bc\uce58\ub294 \ud611\uc9c4\uc2dc\uc2a4\ud15c\uc73c\ub85c \ucc28\uc6d0\uc774 \ub2e4\ub978 \uc694\uc591\uc758\ub8cc\uae30\uad00 \ub0b4\uacfc, \uc7ac\ud65c\uc758\ud559\uacfc, \uc2e0\uacbd\uacfc, \uac00\uc815\uc758\ud559\uacfc, \ud55c\uc758\ud559\uacfc \uc804\ubb38\uc758\uac00 \ub0b4 \uac00\uc871\uac19\uc774 \uc9c4\ub8cc\ud569\ub2c8\ub2e4. CRE\u00b7VRE \uac10\uc5fc \uac71\uc815 \uc5c6\ub294 \ucca0\uc800\ud55c \ub3c5\ub9bd \uaca9\ub9ac\ubcd1\uc2e4 \uc6b4\uc601 \uc5c4\uaca9\ud55c \uac10\uc5fc \uad00\ub9ac \uc6d0\uce59 \uc900\uc218\uc640 \ucf8c\uc801\ud55c \uaca9\ub9ac \ud658\uacbd\uc73c\ub85c \uba74\uc5ed\ub825\uc774 \uc57d\ud55c \ud658\uc790\ubd84\ub4e4\ub3c4 \uc548\uc2ec\ud558\uace0 \ud68c\ubcf5\uc5d0\ub9cc \uc804\ub150\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
