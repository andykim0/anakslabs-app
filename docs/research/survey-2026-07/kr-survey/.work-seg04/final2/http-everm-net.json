    "\uc591\uc545\uc218\uc220 Q&A\u3163\uc5bc\uad74\ubf08\ub2e5\ud130\uc5d0\uac8c \ubb3c\uc5b4\ubd10",
    "\uc9c4\ub2e8\ubd80\ud130 \uc81c\uc791\uae4c\uc9c0, \uc5d0\ubc84\uc5e0 3D \uc591\uc545 \uc2dc\uc2a4\ud15c",
    "\uae30\ub2a5\uc591\uc545\uc740 \uad1c\ucc2e\uace0, \ubbf8\uc6a9\uc591\uc545\uc740 \uc704\ud5d8\ud558\ub2e4?",
    "\ub3cc\ucd9c\uc785 \uc218\uc220, \uc81c\uac00 \uc9c1\uc811 \ubcf4\uc5ec\ub4dc\ub9b4\uac8c\uc694",
    "\uc591\uc545\uc218\uc220\uc5d0 \ub098\uc774\uc81c\ud55c, \uc788\ub2e4?\uc5c6\ub2e4?",
    "\uc5ed\ud68c\uc804 \uc591\uc545\uc218\uc220\uc740 \ub204\uac00\ud558\ub0d0\uace0?!"
   ],
   "keyText": "#QnA #\uc5d0\ubc84\uc5e0\uce58\uacfc \uc591\uc545\uc218\uc220 Q&A\u3163\uc5bc\uad74\ubf08\ub2e5\ud130\uc5d0\uac8c \ubb3c\uc5b4\ubd10 \uac00\uc7a5 \ub9ce\uc774 \ubb3c\uc5b4\ubd10\uc8fc\uc2dc\ub294 \uc9c8\ubb38\ub4e4, \ub871\ud3fc \ubaa8\uc74c\uc9d1! #3D #\uad6c\uac15\uc545\uc548\uba74\uc678\uacfc \uc9c4\ub2e8\ubd80\ud130 \uc81c\uc791\uae4c\uc9c0, \uc5d0\ubc84\uc5e0 3D \uc591\uc545 \uc2dc\uc2a4\ud15c \u201c\ub370\uc774\ud130\ub97c \uae30\ubc18\uc73c\ub85c \ubcc0\ud654\ub97c \uc124\uacc4\ud569\ub2c8\ub2e4.\u201d #\ubbf8\uc6a9\uc591\uc545 #\uae30\ub2a5\uc591\uc545 \uae30\ub2a5\uc591\uc545\uc740 \uad1c\ucc2e\uace0, \ubbf8\uc6a9\uc591\uc545\uc740 \uc704\ud5d8\ud558\ub2e4? \ubbf8\uc6a9 \uc591\uc545\uc218\uc220 \uc704\ud5d8\ud558\ub2e4\ub294 \ub9d0, \uc0ac\uc2e4\uc77c\uae4c? #\ub3cc\ucd9c\uc785 #aso\uc218\uc220 \ub3cc\ucd9c\uc785 \uc218\uc220, \uc81c\uac00 \uc9c1\uc811 \ubcf4\uc5ec\ub4dc\ub9b4\uac8c\uc694 \uc5d0\ubc84\uc5e0\uce58\uacfc\uc5d0\uc11c\uc758 \uc2e4\uc81c aso \uc218\uc220 \uc7a5\uba74\uc744 \ud0c0\uc784\ub7a9\uc2a4 \ud615\ud0dc\ub85c \uacf5\uac1c\ud588\uc2b5\ub2c8\ub2e4! #\uc591\uc545\uc218\uc220 #\uc591\uc545\uc218\uc220\uc2dc\uae30 \uc591\uc545\uc218\uc220\uc5d0 \ub098\uc774\uc81c\ud55c, \uc788\ub2e4?\uc5c6\ub2e4? \uc591\uc545\uc218\uc220 \uc5f0\ub839\ub300\ubcc4 \uace0\ub824\uc0ac\ud56d\uacfc \uc8fc\uc758\uc810\uc744 \uc54c\ub824\ub4dc\ub9b4\uac8c\uc694\ud83d\ude18 #\uc591\uc545\uc218\uc220 #\uc5ed\ud68c\uc804\uc591\uc545 \uc5ed\ud68c\uc804 \uc591\uc545\uc218\uc220\uc740 \ub204\uac00\ud558\ub0d0\uace0?! \uc5ed\ud68c\uc804\uc591\uc545 \uc218\uc220\uc758 \ud6a8\uacfc\ub294? #\uc591\uc545\uc218\uc220 #\uae00\ub85c\ubc8c\ud611\uc9c4 K-\uc591\uc545 \uc138\uacc4",
